# URL privada usada únicamente por el servidor Next.js para comunicarse con Django.
# Desarrollo: http://localhost:8000
# Producción con Docker: http://backend:8000
DJANGO_API=http://localhost:8000

# URL pública que el navegador utiliza para conectarse con LangGraph.
NEXT_PUBLIC_LANGGRAPH_API_URL=http://localhost:2024
NEXT_PUBLIC_LANGGRAPH_ASSISTANT_ID=agent
